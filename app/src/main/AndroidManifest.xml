<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Mọi truy cập file đều qua SAF (content:// URI do người dùng cấp), nên app KHÔNG cần
      bất kỳ quyền lưu trữ nào: không READ/WRITE_EXTERNAL_STORAGE, không MANAGE_EXTERNAL_STORAGE.
      Đã xác nhận trên Android 11: Android/data chỉ đọc được qua SAF tree grant.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FolderCleaner">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MoveActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>

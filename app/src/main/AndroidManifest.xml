<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Lưu ý về quyền:
      - App chủ yếu truy cập file qua SAF (OPEN_DOCUMENT_TREE) nên KHÔNG bắt buộc
        xin quyền lưu trữ. Quyền truy cập thư mục được cấp qua persistable URI.
      - POST_NOTIFICATIONS cần cho Android 13+ để hiển thị thông báo kết quả dọn tự động.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Quyền lưu trữ kiểu cũ (legacy). Vì app target API 28, Android 11 cho dùng
      READ/WRITE_EXTERNAL_STORAGE truy cập thẳng /storage/emulated/0, kể cả Android/data.
      maxSdkVersion để không thừa quyền trên các bản Android mới hơn (nếu nâng target sau này).
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FolderCleaner">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>

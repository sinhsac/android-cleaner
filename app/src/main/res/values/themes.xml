<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Giao diện sáng cố định (không theo chế độ tối của hệ thống).
         Dùng NoActionBar vì mỗi màn đã có MaterialToolbar riêng trong layout;
         nếu để ActionBar mặc định sẽ hiện title "Folder Cleaner" trùng 2 lần. -->
    <style name="Theme.FolderCleaner" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/md_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
